{
  "name": "ethernal-cosmos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "sdk",
    "games/dudg/server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:sdk": "npm run build --workspace=sdk",
    "build": "npm run build:shared && npm run build:server && npm run build:sdk",
    "test": "npm run build && vitest run",
    "test:only": "vitest run",
    "gen:enums": "node scripts/gen-csharp-enums.mjs",
    "check:conformance": "node scripts/check-conformance.mjs"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "vitest": "^5.0.5"
  }
}
