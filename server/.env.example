# Kopiere diese Datei nach .env und passe die Werte an.
# Niemals .env in Git committen!

# Interner Port (nur localhost — Caddy lauscht extern auf :12346 mit HTTPS)
PORT=12348
HOST=127.0.0.1

# Langer, zufälliger String – mindestens 32 Zeichen
JWT_SECRET=aendere_mich_zu_einem_langen_zufaelligen_string

# Interner Port-Pool für Spielinstanzen (inklusiv)
INSTANCE_PORT_MIN=12347
INSTANCE_PORT_MAX=12500

# DUCKDNS_TOKEN wird als Windows System-Umgebungsvariable gesetzt, NICHT hier!

# Optional: Reverse-Proxy-Anzahl für korrekte Client-IPs (Rate-Limits), z.B. 1 hinter Caddy
# TRUST_PROXY=1
# Maximale Anzahl blockierter Nutzer pro Account
# BLOCKS_MAX=200
